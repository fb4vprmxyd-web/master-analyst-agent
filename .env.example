# ─── LLM API Keys (at least one required) ───
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Alpha Vantage API Keys (one per fundamental agent) ───
# Free tier: 5 calls/minute. Separate keys allow parallel data collection.
# Get a free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY_AGENT_1=your_alpha_vantage_key
ALPHA_VANTAGE_KEY_AGENT_2=your_alpha_vantage_key
ALPHA_VANTAGE_KEY_AGENT_3=your_alpha_vantage_key
ALPHA_VANTAGE_KEY_AGENT_4=your_alpha_vantage_key
